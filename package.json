{
  "name": "pinterest-download",
  "productName": "Pinterest Download by GEMADIPADA",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop app to download images from a Pinterest URL",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "python3 run.py",
    "dist": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.gemadipada.pinterest-download",
    "productName": "Pinterest Download by GEMADIPADA",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "backend",
        "filter": [
          "app.py",
          "run.py",
          "downloader.py",
          "settings.py",
          "requirements.txt",
          "static/**"
        ]
      }
    ],
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Pinterest Download by GEMADIPADA"
    },
    "directories": {
      "output": "release"
    }
  }
}
