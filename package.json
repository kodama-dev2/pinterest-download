{
  "name": "pinterest-download",
  "productName": "Pinterest Download by GEMADIPADA",
  "version": "1.0.2",
  "private": true,
  "description": "Desktop app to download images from a Pinterest URL",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "web": "python3 run.py",
    "clean:release": "node scripts/clean-release.cjs",
    "dist": "node scripts/clean-release.cjs && electron-builder --mac --arm64 --x64",
    "dist:win": "node scripts/clean-release.cjs && electron-builder --win zip --x64 --arm64"
  },
  "devDependencies": {
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.gemadipada.pinterest-download",
    "productName": "Pinterest Download by GEMADIPADA",
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "backend",
        "filter": [
          "app.py",
          "run.py",
          "downloader.py",
          "settings.py",
          "requirements.txt",
          "version.py",
          "updater.py",
          "static/**"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
